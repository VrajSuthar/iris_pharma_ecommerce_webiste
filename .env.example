# Copy this file to .env.local and fill in real values before going live.
# Get these from the Razorpay dashboard: https://dashboard.razorpay.com/app/keys
# Test mode keys (rzp_test_...) work end-to-end without moving real money —
# use those while developing, switch to live keys (rzp_live_...) at launch.

# Server-only — never exposed to the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Public — bundled into the client, must match RAZORPAY_KEY_ID above.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
